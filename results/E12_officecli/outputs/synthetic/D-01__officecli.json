   },
   "level": null,
   "style": null
  },
  {
   "block_id": "b0002",
   "type": "paragraph",
   "order": 1,
   "text": "표 1은 V1 구성(2026-01-01~2026-11-30), 표 2는 V2 구성(2026-12-01~)이다. V2에서 강판(M001) 소요량이 1.2 kg에서 1,000 g으로 바뀌었다 (The steel sheet quantity changed from 1.2 kg to 1000 g).",
   "location": {
    "format": "docx",
    "part": "body",
    "body_index": 1,
    "officecli_path": "/body/p[@paraId=00100002]"
   },
   "level": null,
   "style": null
  },
  {
   "block_id": "b0003",
   "type": "paragraph",
   "order": 2,
   "text": "표 1. FG001 BOM V1 (2026-01-01~2026-11-30)",
