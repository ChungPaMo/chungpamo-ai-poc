{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chungpamo:e10:candidate_provider_contract:v0.1",
  "title": "E10 매핑 후보 제공자 계약 (규칙 / BM25 / 임베딩 / Tri-CHEF / LLM 공통, 2026-10-21 초안)",
  "description": "후보 제공자는 후보만 만든다. 값 검증·staging·승인·반영은 공통 단계(scripts/e10_mock_erp.py)가 한다. 같은 E10 평가셋(data/canonical/e10/eval_set_v1.json)의 입력 행을 받아 같은 형식으로 내야 비교할 수 있다. Tri-CHEF·임베딩·LLM 구현은 검색·에이전트 담당 범위이며 여기서는 형식만 정한다. score는 제공자가 실제로 계산한 값만 넣는다.",
  "$defs": {
    "ProviderRequest": {
      "type": "object",
      "required": ["request_id", "provider", "inputs", "target_schema_ref"],
      "properties": {
        "request_id": {"type": "string"},
        "provider": {"type": "object", "required": ["method", "name", "version"],
          "properties": {"method": {"enum": ["RULE_CODE_TABLE", "RULE_HEADER", "RULE_NAME_EXACT", "KEYWORD_BM25", "EMBEDDING", "TRI_CHEF", "LLM"]},
                         "name": {"type": "string"}, "version": {"type": "string"},
                         "external_api": {"type": "boolean", "description": "외부 API 사용 여부. true면 합성 데이터만, 사전 승인 필요"}}},
        "target_schema_ref": {"type": "string", "description": "모의 ERP 대상 테이블·필드 목록의 출처 (schemas/e10_mock_erp.sql sha256)"},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/MappingInput"}}
      }
    },
    "MappingInput": {
      "type": "object",
      "required": ["input_id", "source_file", "source_sha256", "location", "header", "raw_value"],
      "properties": {
        "input_id": {"type": "string", "description": "{batch_id}:{row}:{header}"},
        "source_file": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "location": {"type": "object", "description": "공통 IR §3 위치 (CSV는 row·col)"},
        "header": {"type": "string"}, "raw_value": {"type": "string"},
        "row_context": {"type": "object", "description": "같은 행의 다른 헤더·원값 (교차 필드 일관성 판단용 — E10 M13 결함 대응)"},
        "extraction_confidence": {"type": ["number", "null"], "description": "파서가 실제로 낸 점수만, 없으면 null"}
      }
    },
    "ProviderCandidate": {
      "type": "object",
      "required": ["input_id", "proposed_entity", "proposed_field", "proposed_value", "rank", "method"],
      "properties": {
        "input_id": {"type": "string"},
        "proposed_entity": {"enum": ["ProductMaster", "MaterialMaster", "SupplierMaster", "SupplierItem", "UnitMaster", "BOMHeader", "BOMLine", "SalesOrder",
                                     "Inventory", "ProductionCapacity", "Routing"]},
        "proposed_field": {"type": "string"},
        "proposed_value": {"type": ["string", "null"], "description": "값을 정할 수 없으면 null (임의 값 금지)"},
        "rank": {"type": "integer", "minimum": 1},
        "method": {"type": "string"},
        "score": {"type": ["number", "null"]},
        "evidence": {"type": "object", "description": "근거 (일치한 마스터 레코드, 검색 문서 ID 등)"},
        "conflicts_with": {"type": "array", "items": {"type": "string"}, "description": "같은 행에서 서로 다른 값을 가리키는 다른 후보 input_id"}
      }
    },
    "ProviderResponse": {
      "type": "object",
      "required": ["request_id", "candidates", "timing_ms"],
      "properties": {
        "request_id": {"type": "string"},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/ProviderCandidate"}},
        "unmapped_inputs": {"type": "array", "items": {"type": "string"}},
        "timing_ms": {"type": "number"},
        "api_usage": {"type": ["object", "null"], "description": "외부 API 사용 시 실제 호출 수·토큰·청구 기록. 추정 금지"}
      }
    }
  },
  "evaluation": "같은 평가셋에서 지표(field/value mapping accuracy, wrong-value commit rate, auto-accept coverage 등)를 scripts/e10_run.py 채점 방식으로 계산한다. 공통 단계가 제공자 후보를 받는 진입점(stage_candidates)은 아직 구현하지 않았다 — 현재는 규칙 기반 제공자만 stage_batch 안에 들어 있다"
}
