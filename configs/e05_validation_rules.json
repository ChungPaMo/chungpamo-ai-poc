{
  "_meta": {
    "version": "v1",
    "created": "2026-10-21",
    "purpose": "E05 검증 규칙 카탈로그 — 기존 문서·E01 모델에 근거한 규칙만 ERROR로 둔다. 근거가 없는 규칙은 synthetic_assumption=true(합성 실험용 가정, 실제 기업 규칙 아님) 또는 NOT_MEASURED",
    "basis_documents": {
      "SCHEMA": "docs/manufacturing_data_schema.md (§3 필드 정의, §5 QR-01~QR-08)",
      "PROTOCOL": "docs/evaluation_protocol.md (§2.4 오류 코드, §4.1 판정)",
      "MODEL": "scripts/e01_models.py (E01 pydantic 모델, 수정하지 않고 재사용)",
      "LOGIC": "docs/decision_logic.md (§4·§5·§6.1 계산 규칙)",
      "GT": "data/canonical/ground_truth_v2.json (dataset.assumptions, expected)"
    },
    "layers": ["schema", "referential", "relational", "business"],
    "severity": {"ERROR": "데이터 오류 — 정확도 채점 대상", "WARNING": "합성 가정 기반 또는 판단 보조 — 오류 정확도와 따로 집계", "INFO": "계산 결과 보고(데이터 오류 아님)"},
    "shacl_fit": {"CORE": "SHACL Core로 표현 가능 (schema §5 설계안 기준)", "SPARQL": "SHACL-SPARQL 필요", "PARTIAL": "일부만 Core", "NOT_SUITABLE": "계산·집계 위주로 SHACL 비교 대상 아님"},
    "error_codes_added_in_e05": {"ERR-ENUM": "허용되지 않은 열거값 (프로토콜 §2.4에 코드 없음 — E05에서 추가, 팀 확인 필요)", "ERR-IDFMT": "식별자 형식 오류 (record_uid 패턴, 동일)"}
  },
  "rules": [
    {"rule_id": "S01", "layer": "schema", "target": "모든 엔터티", "description": "필수 필드 누락 (null 또는 빈 문자열)", "error_code": "ERR-MISSING", "severity": "ERROR",
     "method": {"python": "pydantic 필수 필드(missing·None) + 빈 문자열 사전 검사", "sql": "필수 열 IS NULL OR = ''"}, "input_fields": "엔터티별 필수 필드 (schema §3 필수=Y)",
     "expected_result": "레코드·필드 단위 보고", "basis": "SCHEMA §3 필수 열, MODEL 필수 필드, PROTOCOL ERR-MISSING", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "S02", "layer": "schema", "target": "숫자 필드", "description": "숫자 형식 오류 (decimal·integer로 해석 불가)", "error_code": "ERR-NUMFMT", "severity": "ERROR",
     "method": {"python": "pydantic Decimal/int 변환 실패", "sql": "CAST 왕복 비교·GLOB 숫자 패턴"}, "input_fields": "decimal·integer 필드",
     "expected_result": "레코드·필드", "basis": "SCHEMA §5 ERR-NUMFMT, MODEL 타입", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "S03", "layer": "schema", "target": "날짜 필드", "description": "날짜 형식 오류·존재하지 않는 날짜 (QR-04 ①)", "error_code": "ERR-DATE", "severity": "ERROR",
     "method": {"python": "pydantic date 변환 실패 (ISO YYYY-MM-DD)", "sql": "date(x) = x (SQLite date()는 2026-02-30을 2026-03-02로 바꾸므로 왕복 비교 필수)"}, "input_fields": "date 필드",
     "expected_result": "레코드·필드", "basis": "SCHEMA §5 QR-04 ①", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "S04", "layer": "schema", "target": "열거형 필드", "description": "허용되지 않은 열거값 (대소문자 포함 완전 일치)", "error_code": "ERR-ENUM", "severity": "ERROR",
     "method": {"python": "pydantic Literal", "sql": "NOT IN (허용값)"}, "input_fields": "product_type, status, component_type, priority, item_type, resource_type, generated_by, production_mode, dimension, period_grain, generation_method, origin_class, line_type",
     "expected_result": "레코드·필드", "basis": "SCHEMA §3 enum, MODEL Literal", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "S05", "layer": "schema", "target": "모든 엔터티", "description": "record_uid 형식 오류 (^rec_[0-9a-f]{16}$)", "error_code": "ERR-IDFMT", "severity": "ERROR",
     "method": {"python": "pydantic pattern", "sql": "GLOB 'rec_' + 16자리 16진수"}, "input_fields": "record_uid",
     "expected_result": "레코드·필드", "basis": "MODEL _Base.record_uid 패턴", "synthetic_assumption": false, "shacl_fit": "CORE",
     "note": "업무 ID(product_id 등)의 형식은 기존 문서에 정의가 없어 검사하지 않음 → NOT_MEASURED (N01)"},
    {"rule_id": "S06", "layer": "schema", "target": "수량·비율 필드", "description": "숫자 범위 위반 (소요량·주문량·기준수량 > 0, 그 밖 수량 ≥ 0, 손실률 0 이상 1 미만, 배분 비율 0 초과 1 이하)", "error_code": "ERR-NUMFMT", "severity": "ERROR",
     "method": {"python": "pydantic gt/ge/lt/le", "sql": "CHECK 조건과 같은 WHERE"}, "input_fields": "qty_per, order_qty, base_qty, min_qty, unit_cost, safety_stock_qty, lead_time_days, scrap_rate, allocation_share, regular_hours_per_day, run_time_per_unit_h, planned_qty 등 (재고 보유 수량은 V01)",
     "expected_result": "레코드·필드", "basis": "SCHEMA §3 키·관계 열, MODEL Field 제약", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "S07", "layer": "schema", "target": "선택 문자열 필드", "description": "선택 필드에 빈 문자열 (null이어야 함)", "error_code": "ERR-MISSING", "severity": "WARNING",
     "method": {"python": "사전 검사", "sql": "= ''"}, "input_fields": "site_id, valid_to, source_series_id 등 선택 필드",
     "expected_result": "레코드·필드 경고", "basis": "합성 가정: 빈 문자열과 null을 구분하는 규칙은 기존 문서에 없음", "synthetic_assumption": true, "shacl_fit": "CORE"},
    {"rule_id": "S08", "layer": "schema", "target": "모든 엔터티 (Inventory 제외)", "description": "업무 키 중복 (QR-01) — 단일 키 또는 복합 키(BOMLine bom_id+line_no, SupplierMaterial, SalesHistory, Operation, PlanLine)", "error_code": "ERR-DUPID", "severity": "ERROR",
     "method": {"python": "키별 그룹 개수", "sql": "GROUP BY 키 HAVING COUNT(*) > 1 (PK 제약 대신 사전 집계)"}, "input_fields": "엔터티별 PK",
     "expected_result": "관련 레코드 전부, 필드 *", "basis": "SCHEMA §3 PK, §5 QR-01", "synthetic_assumption": false, "shacl_fit": "SPARQL"},
    {"rule_id": "R01", "layer": "referential", "target": "BOM, BOMLine, Order, Operation, ProductionPlanLine, SalesHistory, Inventory(PRODUCT)", "description": "존재하지 않는 제품 참조 (QR-02)", "error_code": "ERR-BADREF", "severity": "ERROR",
     "method": {"python": "ID 집합 조회", "sql": "LEFT JOIN … IS NULL"}, "input_fields": "product_id, component_product_id, item_id",
     "expected_result": "참조 레코드, FK 필드", "basis": "SCHEMA §3 FK, §5 QR-02", "synthetic_assumption": false, "shacl_fit": "PARTIAL"},
    {"rule_id": "R02", "layer": "referential", "target": "BOMLine, SupplierMaterial, Inventory(MATERIAL)", "description": "존재하지 않는 자재 참조 (QR-02) — 매핑되지 않은 외부(업체) 코드 포함", "error_code": "ERR-BADREF", "severity": "ERROR",
     "method": {"python": "ID 집합 조회", "sql": "LEFT JOIN … IS NULL"}, "input_fields": "component_material_id, material_id, item_id",
     "expected_result": "참조 레코드, FK 필드", "basis": "SCHEMA §5 QR-02", "synthetic_assumption": false, "shacl_fit": "PARTIAL"},
    {"rule_id": "R03", "layer": "referential", "target": "SupplierMaterial", "description": "존재하지 않는 공급사 참조 (QR-02)", "error_code": "ERR-BADREF", "severity": "ERROR",
     "method": {"python": "ID 집합 조회", "sql": "LEFT JOIN … IS NULL"}, "input_fields": "supplier_id", "expected_result": "참조 레코드, FK 필드",
     "basis": "SCHEMA §3.5 FK, §5 QR-02", "synthetic_assumption": false, "shacl_fit": "PARTIAL"},
    {"rule_id": "R04", "layer": "referential", "target": "BOMLine", "description": "존재하지 않는 BOM 참조", "error_code": "ERR-BADREF", "severity": "ERROR",
     "method": {"python": "ID 집합 조회", "sql": "LEFT JOIN … IS NULL"}, "input_fields": "bom_id", "expected_result": "참조 레코드, FK 필드",
     "basis": "SCHEMA §3.7 FK→BOM", "synthetic_assumption": false, "shacl_fit": "PARTIAL"},
    {"rule_id": "R05", "layer": "referential", "target": "Operation, ProductionPlanLine", "description": "존재하지 않는 생산 자원 참조 (QR-08 ①)", "error_code": "ERR-RESREL", "severity": "ERROR",
     "method": {"python": "ID 집합 조회", "sql": "LEFT JOIN … IS NULL"}, "input_fields": "resource_id", "expected_result": "참조 레코드, resource_id",
     "basis": "SCHEMA §5 QR-08 ①, §3.13 FK→Resource", "synthetic_assumption": false, "shacl_fit": "PARTIAL"},
    {"rule_id": "R06", "layer": "referential", "target": "ProductionPlanLine", "description": "존재하지 않는 계획 참조", "error_code": "ERR-BADREF", "severity": "ERROR",
     "method": {"python": "ID 집합 조회", "sql": "LEFT JOIN … IS NULL"}, "input_fields": "plan_id", "expected_result": "참조 레코드, plan_id",
     "basis": "SCHEMA §3.13 FK→Plan", "synthetic_assumption": false, "shacl_fit": "PARTIAL"},
    {"rule_id": "R07", "layer": "referential", "target": "단위 필드가 있는 엔터티", "description": "단위가 Unit 목록에 없음 (QR-03 ①)", "error_code": "ERR-UNIT", "severity": "ERROR",
     "method": {"python": "Unit 코드 집합 조회", "sql": "LEFT JOIN Unit"}, "input_fields": "unit, base_unit, base_unit_code", "expected_result": "레코드, 단위 필드",
     "basis": "SCHEMA §5 QR-03 ①", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "B01", "layer": "relational", "target": "BOM·BOMLine", "description": "다단계 BOM 순환 (자기 참조 포함, QR-05)", "error_code": "ERR-BOMCYCLE", "severity": "ERROR",
     "method": {"python": "제품→반제품 그래프 깊이 우선 탐색", "sql": "재귀 CTE 경로 전개, 출발 제품 재등장"}, "input_fields": "BOM.product_id, BOMLine.component_product_id",
     "expected_result": "순환 경로의 BOMLine 레코드 전부", "basis": "SCHEMA §5 QR-05", "synthetic_assumption": false, "shacl_fit": "SPARQL"},
    {"rule_id": "B02", "layer": "relational", "target": "BOM", "description": "같은 제품의 활성·승인 버전 유효 조건 중복 (기간·수량·사이트 동시 겹침, QR-06 ①)", "error_code": "ERR-BOMVER", "severity": "ERROR",
     "method": {"python": "제품별 버전 쌍 비교", "sql": "자기 조인 + schema §5 판정식"}, "input_fields": "valid_from, valid_to, min_qty, max_qty, site_id",
     "expected_result": "충돌 BOM 레코드 전부", "basis": "SCHEMA §5 QR-06 ① 판정식 (종료일 포함, 수량 상한 미포함)", "synthetic_assumption": false, "shacl_fit": "SPARQL"},
    {"rule_id": "B03", "layer": "relational", "target": "BOM", "description": "미승인(DRAFT) 버전이 활성 (QR-06 ②)", "error_code": "ERR-BOMVER", "severity": "ERROR",
     "method": {"python": "pydantic model_validator", "sql": "is_active AND status <> 'APPROVED'"}, "input_fields": "status, is_active", "expected_result": "레코드",
     "basis": "SCHEMA §3.6 S1 ②③, §5 QR-06 ②", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "B04", "layer": "relational", "target": "BOM", "description": "같은 제품·버전 표기 중복 (QR-06 ③, UK product_id+bom_version)", "error_code": "ERR-BOMVER", "severity": "ERROR",
     "method": {"python": "그룹 개수", "sql": "GROUP BY product_id, bom_version"}, "input_fields": "product_id, bom_version", "expected_result": "관련 레코드",
     "basis": "SCHEMA §3.6 UK, §5 QR-06 ③", "synthetic_assumption": false, "shacl_fit": "SPARQL"},
    {"rule_id": "B05", "layer": "relational", "target": "BOM", "description": "유효 조건 자체 오류: valid_to < valid_from, max_qty ≤ min_qty (QR-04 ③, QR-06 ④)", "error_code": "ERR-BOMVER", "severity": "ERROR",
     "method": {"python": "pydantic model_validator", "sql": "비교 조건"}, "input_fields": "valid_from, valid_to, min_qty, max_qty", "expected_result": "레코드, 조건 필드",
     "basis": "SCHEMA §5 QR-06 ④", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "B06", "layer": "relational", "target": "ProductionPlanLine(INHOUSE)", "description": "계획 라인의 (제품, 기간 시작일, 계획 수량)에 적용 가능한 활성 BOM이 0개(선택 불가) 또는 2개 이상(모호) (QR-06 ⑤, BOM 선택 규칙)", "error_code": "ERR-BOMVER", "severity": "ERROR",
     "method": {"python": "BOM 선택 규칙 적용", "sql": "계획 라인 × BOM 후보 조인 집계"}, "input_fields": "plan line product_id, period_start, planned_qty; BOM 유효 조건",
     "expected_result": "계획 라인 레코드", "basis": "SCHEMA §3.6 BOM 버전 선택 규칙, GT parameters.plan_bom_selection_date=period_start", "synthetic_assumption": false, "shacl_fit": "SPARQL",
     "note": "BOM이 없는 원자재 품목은 대상 아님. 반제품 BOM이 없어도 반제품 계획 라인이면 대상"},
    {"rule_id": "B07", "layer": "relational", "target": "BOMLine", "description": "component_type과 구성품 ID 열 불일치", "error_code": "ERR-BADREF", "severity": "ERROR",
     "method": {"python": "pydantic model_validator", "sql": "조건식"}, "input_fields": "component_type, component_material_id, component_product_id", "expected_result": "레코드",
     "basis": "SCHEMA §3.7 조건부 FK, MODEL BOMLine._component", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "B08", "layer": "relational", "target": "BOMLine, Order, Inventory, ProductionPlanLine", "description": "수량 단위의 차원이 품목 기준 단위 차원과 다름 (예: kg 자재에 EA, QR-03 ②). 같은 차원 다른 단위(g↔kg)는 정상", "error_code": "ERR-UNIT", "severity": "ERROR",
     "method": {"python": "Unit.dimension 비교", "sql": "Unit 두 번 조인해 dimension 비교"}, "input_fields": "unit, 품목 base_unit", "expected_result": "레코드, unit",
     "basis": "SCHEMA §3.7 unit 열, §5 QR-03 ②", "synthetic_assumption": false, "shacl_fit": "SPARQL"},
    {"rule_id": "B09", "layer": "relational", "target": "BOM", "description": "라인이 하나도 없는 BOM (구성품 누락)", "error_code": "ERR-BOMVER", "severity": "WARNING",
     "method": {"python": "BOM별 라인 수", "sql": "NOT EXISTS"}, "input_fields": "BOM.bom_id, BOMLine.bom_id", "expected_result": "BOM 레코드 경고",
     "basis": "합성 가정: BOM 1—N BOMLine의 최소 개수(N≥1)는 기존 문서에 명시되지 않음", "synthetic_assumption": true, "shacl_fit": "CORE"},
    {"rule_id": "B10", "layer": "relational", "target": "BOMLine", "description": "같은 BOM 안에 같은 구성품이 두 번 이상", "error_code": "ERR-DUPID", "severity": "WARNING",
     "method": {"python": "그룹 개수", "sql": "GROUP BY bom_id, 구성품"}, "input_fields": "bom_id, component_*_id", "expected_result": "라인 레코드 경고",
     "basis": "합성 가정: 기존 문서에 금지 규칙 없음 (실무에서는 정상일 수도 있음)", "synthetic_assumption": true, "shacl_fit": "SPARQL"},
    {"rule_id": "B11", "layer": "relational", "target": "SupplierMaterial", "description": "자재당 우선 공급사(is_preferred=TRUE)가 정확히 1개가 아님 (공급 관계가 있는 자재 기준)", "error_code": "ERR-DUPID", "severity": "ERROR",
     "method": {"python": "자재별 개수", "sql": "GROUP BY material_id HAVING SUM(is_preferred) <> 1"}, "input_fields": "material_id, is_preferred",
     "expected_result": "해당 자재의 공급 관계 레코드", "basis": "SCHEMA §3.5 is_preferred '자재당 TRUE 1개', GT 가정 5 (우선 공급사 리드타임 사용)", "synthetic_assumption": false, "shacl_fit": "SPARQL"},
    {"rule_id": "B12", "layer": "relational", "target": "SalesHistory(ALLOCATED)", "description": "같은 원본 레코드에서 배분한 행들의 allocation_share 합 ≠ 1 (허용오차 0.0005)", "error_code": "ERR-NUMFMT", "severity": "ERROR",
     "method": {"python": "원본별 합계", "sql": "GROUP BY derived_from_record_uid"}, "input_fields": "derived_from_record_uid, allocation_share",
     "expected_result": "해당 원본에서 나온 행 전부", "basis": "SCHEMA §3.9 allocation_share 합 = 1", "synthetic_assumption": false, "shacl_fit": "SPARQL",
     "note": "허용오차 0.0005는 E01 배분 비율이 소수 4자리로 반올림되어 있어 정한 실험값 (팀 확인 필요)"},
    {"rule_id": "B13", "layer": "relational", "target": "SalesHistory", "description": "ALLOCATED 행에 원본 레코드·배분 비율 없음", "error_code": "ERR-MISSING", "severity": "ERROR",
     "method": {"python": "pydantic model_validator", "sql": "조건식"}, "input_fields": "generation_method, derived_from_record_uid, allocation_share", "expected_result": "레코드",
     "basis": "SCHEMA §3.9 조건부 필수, MODEL SalesHistory._allocation", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "B14", "layer": "relational", "target": "Product", "description": "외주 단가는 외주 허용 제품에만 있음", "error_code": "ERR-MISSING", "severity": "ERROR",
     "method": {"python": "pydantic model_validator", "sql": "조건식"}, "input_fields": "outsourcing_allowed, outsourcing_unit_cost", "expected_result": "레코드",
     "basis": "MODEL Product._outsourcing", "synthetic_assumption": false, "shacl_fit": "CORE"},
    {"rule_id": "V01", "layer": "business", "target": "Inventory", "description": "음수 보유 재고 (QR-07 ①)", "error_code": "ERR-INVQTY", "severity": "ERROR",
