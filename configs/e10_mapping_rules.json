{
  "_meta": {
    "version": "v0.3",
    "created": "2026-10-21",
    "status": "E10 1차 실험(scripts/e10_*.py)이 사용. 모의 ERP 대상이며 실제 기업 ERP 규칙이 아니다",
    "purpose": "E10 규칙 기반 매핑(Baseline)의 후보 생성·검토 판정 규칙 초안. 모의 ERP 대상이며 실제 기업 ERP 규칙이 아니다",
    "references": {
      "contract": "docs/e10_data_contract.md",
      "evaluation": "docs/e10_evaluation_protocol.md",
      "ddl": "schemas/e10_mock_erp.sql",
      "vendor_headers_and_codes": "configs/e02_vendor_mapping.json (vendors.*.files[].columns, vendors.*.codes, units) — 참조만, 복사하지 않음",
      "value_validation": "configs/e05_validation_rules.json (규칙 ID 재사용)"
    },
    "assumptions": [
      "E10-ASM-01: E02 코드 대응표를 사내 기준정보로 간주",
      "E10-ASM-03: 단일 사이트(site_id = null)"
    ],
    "undecided": [
      "auto_accept.allowed_fields",
      "점수 기반 방식의 자동 승인 기준",
      "승인 절차(1인/2인)"
    ]
  },
  "entity_map": {
    "ProductMaster": {
      "e01_entity": "Product",
      "key": [
        "product_id"
      ]
    },
    "MaterialMaster": {
      "e01_entity": "Material",
      "key": [
        "material_id"
      ]
    },
    "SupplierMaster": {
      "e01_entity": "Supplier",
      "key": [
        "supplier_id"
      ]
    },
    "SupplierItem": {
      "e01_entity": "SupplierMaterial",
      "key": [
        "supplier_id",
        "material_id"
      ]
    },
    "UnitMaster": {
      "e01_entity": "Unit",
      "key": [
        "unit_code"
      ]
    },
    "BOMHeader": {
      "e01_entity": "BOM",
      "key": [
        "bom_id"
      ],
      "unique": [
        [
          "product_id",
          "bom_version"
        ]
      ]
    },
    "BOMLine": {
      "e01_entity": "BOMLine",
      "key": [
        "bom_id",
        "line_no"
      ]
    },
    "SalesOrder": {
      "e01_entity": "Order",
      "key": [
        "order_id"
      ]
    },
    "Inventory": {
      "e01_entity": "Inventory",
      "key": [
        "item_type",
        "item_id",
        "as_of_date"
      ]
    },
    "ProductionCapacity": {
      "e01_entity": "Resource",
      "key": [
        "resource_id"
      ],
      "note": "능력 단위는 시간/일"
    },
    "Routing": {
      "e01_entity": "Operation",
      "key": [
        "operation_id"
      ],
      "unique": [
        [
          "product_id",
          "sequence_no"
        ]
      ]
    }
  },
  "candidate_rules": [
    {
      "rule_id": "M-01",
      "method": "RULE_HEADER",
      "description": "업체 파일 헤더 → E01 필드 (E02 설정의 columns 대응)",
      "review_required": false
    },
    {
      "rule_id": "M-02",
      "method": "RULE_CODE_TABLE",
      "description": "업체 코드 → 사내 코드 (E02 설정의 codes 대응표 정확 일치)",
      "review_required": false,
      "scenario": [
        "M01"
      ]
    },
    {
      "rule_id": "M-03",
      "method": "RULE_CODE_TABLE",
      "description": "원본 값이 사내 코드(product_id 등)와 정확히 일치",
      "review_required": false
    },
    {
      "rule_id": "M-04",
      "method": "RULE_NAME_EXACT",
      "description": "정규화 이름(공백·대소문자 제거) 일치 — 이름은 식별자가 아니므로 항상 검토",
      "normalize": [
        "strip",
        "remove_whitespace",
        "casefold"
      ],
      "review_required": true,
      "scenario": [
        "M02"
      ]
    },
    {
      "rule_id": "M-05",
      "method": "RULE_NAME_EXACT",
      "description": "정규화 이름이 둘 이상의 사내 레코드와 일치하거나 접두 일치 — 모호, 자동 확정 금지",
      "review_required": true,
      "ambiguous": true,
      "scenario": [
        "M03"
      ]
    },
    {
      "rule_id": "M-06",
      "method": "RULE_CODE_TABLE",
      "description": "코드표·사내 코드 어디에도 없음 — 후보 없음, REJECT",
      "review_required": true,
      "decision": "REJECT",
      "scenario": [
        "M04"
      ]
    }
  ],
  "value_rules": [
    {
      "rule_id": "M-10",
      "description": "단위 → 기준 단위 환산은 UnitMaster.dimension이 같을 때만. 다르면 ERROR",
      "e05_rule": "B08",
      "error_code": "ERR-UNIT",
      "scenario": [
        "M05"
      ]
    },
    {
      "rule_id": "M-11",
      "description": "숫자 정규화는 E02 업체별 number_format(plain/thousands)만 허용. NaN·Infinity·지수·전각 숫자 거부 (E05·E06 실측 결함 대응)",
      "e05_rule": "S02",
      "error_code": "ERR-NUMFMT",
      "scenario": [
        "M06"
      ]
    },
    {
      "rule_id": "M-12",
      "description": "수량 범위는 E01 모델 제약(order_qty > 0 등)",
      "e05_rule": "S06",
      "error_code": "ERR-NUMFMT",
      "scenario": [
        "M06"
      ]
    },
    {
      "rule_id": "M-13",
      "description": "날짜는 E02 업체별 date_format으로만 해석, ISO 왕복 확인",
      "e05_rule": "S03",
      "error_code": "ERR-DATE"
    },
    {
      "rule_id": "M-14",
      "description": "업무 키 중복 (배치 안 + 본 테이블)",
      "e05_rule": "S08",
      "error_code": "ERR-DUPID",
      "scenario": [
        "M07"
      ]
    },
    {
      "rule_id": "M-15",
      "description": "구버전 입력: 같은 제품의 BOM에서 입력 버전·유효기간이 본 테이블의 현재 버전보다 오래됨 → SUPERSEDED_INPUT, 덮어쓰기 금지",
      "e05_rule": "B06",
      "error_code": "ERR-BOMVER",
      "scenario": [
        "M08"
      ]
    },
    {
      "rule_id": "M-16",
      "description": "활성 버전 유효 조건 겹침",
      "e05_rule": "B02",
      "error_code": "ERR-BOMVER",
      "scenario": [
        "M09"
      ]
    },
    {
      "rule_id": "M-17",
      "description": "참조 대상 존재 (모의 ERP 본 테이블 + 같은 배치의 승인 대기 마스터)",
      "e05_rule": "R01-R07",
      "error_code": "ERR-BADREF",
      "scenario": [
        "M10"
      ]
    },
    {
      "rule_id": "M-18",
      "description": "재반입: 같은 dedup_key가 이미 반영됨 → 신규 레코드 생성 금지",
      "error_code": "ERR-DUPID",
      "scenario": [
        "M11"
      ]
    },
    {
      "rule_id": "M-19",
      "description": "본 테이블 쓰기는 ApprovalLog.APPROVED가 있을 때만 (DDL 트리거)",
      "error_code": "E10-NOT-APPROVED",
      "scenario": [
        "M12"
      ]
    },
    {
      "rule_id": "M-20",
      "description": "같은 배치에서 서로 다른 후보가 같은 ERP 키에 다른 값을 제안 — 키 충돌, 모두 승인 불가",
      "error_code": "ERR-DUPID",
      "scenario": [
        "X07"
      ]
    },
    {
      "rule_id": "M-21",
      "description": "이름 매핑이 둘 이상 레코드와 일치(모호) — 승인자가 후보를 지정하기 전에는 승인 불가(ERROR)",
      "error_code": "ERR-BADREF",
      "scenario": [
        "M03"
      ]
    },
    {
      "rule_id": "M-22",
      "description": "승인 시점 원본 sha256이 staging 시점과 다르면 승인 거부 (STALE_SOURCE)",
      "error_code": "E10-STALE-SOURCE",
      "scenario": [
        "X02"
      ]
    },
    {
      "rule_id": "M-23",
      "description": "등록되지 않았거나 비활성인 승인자 거부 (애플리케이션 + Reviewer FK)",
      "error_code": "E10-BAD-REVIEWER",
      "scenario": [
        "X03"
      ]
    },
    {
      "rule_id": "M-24",
      "description": "같은 필드에 서로 다른 후보(예: 제품코드 → FG002, 제품명 → FG001) — CONFLICT, 값을 확정하지 않고 승인 불가(ERROR). 승인자가 원본 확인 후 다시 반입",
      "error_code": "E10-CONFLICT",
      "scenario": [
        "M13",
        "C01"
      ],
      "mapper": "v2"
    },
    {
      "rule_id": "M-25",
      "description": "비활성 BOM 헤더에 대한 라인 변경 — 경고, 자동 승인 금지",
      "error_code": "ERR-BOMVER",
      "scenario": [
        "C04"
      ],
      "mapper": "v2"
    }
  ],
  "auto_accept": {
    "requires_all": [
      "matching_method in (RULE_CODE_TABLE, RULE_HEADER)",
      "validation_status == PASSED",
      "dedup_key not committed",
      "not SUPERSEDED_INPUT",
      "field in allowed_fields"
    ],
    "allowed_fields": "팀 합의 필요 (초안에서는 비워 둠 — 모든 후보 검토)",
    "record_auto_approval_as": "AUTO_RULE",
    "experimental_policy_e10_v1": {
      "allowed_fields": "*",
      "applies_only_when": "레코드의 모든 필드 후보가 RULE_HEADER·RULE_CODE_TABLE이고 ERROR 0, 신규 INSERT(UPDATE는 항상 검토)",
      "note": "E10 1차 실험 전용 설정. 실제 허용 필드는 팀 합의 필요 — 결과는 이 설정에서의 값이다"
    },
    "default_policy_v2": {
      "value": "REVIEW_REQUIRED",
      "note": "자동 승인 정책이 확정되지 않았으므로 v2 매퍼의 기본값은 모든 staging 검토. experimental 정책을 명시하면 신규 주문 INSERT에만, 오류·경고·충돌·중복·구버전이 하나도 없을 때만 허용"
    }
  }
}
