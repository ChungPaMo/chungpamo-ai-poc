# ---- Python 가상환경·캐시 ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 비밀 설정 (.env.example만 추적) ----
.env
.env.*
!.env.example
*.key
*.pem
secrets/
configs/*.local.*
configs/*secret*

# ---- 실제 기업 데이터 (외부 반출·추적 금지) ----
data/raw/*
!data/raw/.gitkeep
data/private/

# ---- 비공개 원본 문서 ----
# docs/ 바로 아래의 원본 문서는 모두 비공개로 취급한다 (작성 문서는 .md 사용)
docs/*.pdf
docs/*.docx
docs/*.doc
docs/*.hwp
docs/*.hwpx
docs/*.xlsx
docs/private/

# ---- 도구 ----
.vscode/
*.log
