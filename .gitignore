# ---- Python 가상환경·캐시 ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---- 임시파일·로그 ----
*.tmp
*.bak
*.swp
~$*
Thumbs.db
.DS_Store
*.log
logs/

# ---- 비밀 설정·인증정보 (.env.example만 추적) ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials*.json
kaggle.json
.kaggle/
configs/*.local.*
configs/*secret*
*.local.json
*.local.toml

# ---- 원본 데이터 (실제 기업 데이터·공개 데이터 원본: 추적 금지) ----
# data/raw/ 아래에는 UCI 원본 zip·CSV, 공개 원본 스테이징, 향후 실제 기업 데이터가 들어간다
data/raw/*
!data/raw/.gitkeep
data/private/

# ---- 비공개 원본 문서 ----
# docs/ 바로 아래의 원본 문서는 모두 비공개로 취급한다 (작성 문서는 .md 사용)
docs/*.pdf
docs/*.docx
docs/*.doc
docs/*.hwp
docs/*.hwpx
docs/*.xlsx
docs/private/

# ---- 공개 보류 문서: 임베드된 한글 폰트 서브셋(맑은 고딕)의 재배포 조건 미확인 (decisions.md D-020) ----
# 로컬에서만 보관·검증한다. 재배포 가능 폰트로 다시 만들거나 조건이 확인되면 해제한다.
data/documents/P-01_bom_spec.pdf
data/documents/P-02_order_inventory.pdf

# ---- 폰트 파일 (라이선스상 재배포 금지 가능 — 시스템 폰트를 로컬에서만 사용) ----
*.ttf
*.otf
*.ttc
*.woff
*.woff2

# ---- 도구 ----
.vscode/
*.log
