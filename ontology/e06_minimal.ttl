cp:BOMLine_component_type a owl:DatatypeProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range xsd:string .
cp:BOMLine_component_material_id a owl:ObjectProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range cp:Material .
cp:BOMLine_component_product_id a owl:ObjectProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range cp:Product .
cp:BOMLine_qty_per a owl:DatatypeProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range xsd:decimal .
cp:BOMLine_unit a owl:ObjectProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range cp:Unit .
cp:BOMLine_scrap_rate a owl:DatatypeProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range xsd:decimal .
cp:BOMLine_line_type a owl:DatatypeProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range xsd:string .

