# E06 최소 온톨로지 (scripts/e06_build_rdf.py가 E01 모델 정의에서 생성). OWL 추론에 쓰지 않음 — 어휘 문서화용.
@prefix cp: <http://example.org/chungpamo/e06/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/chungpamo/e06/ns> a owl:Ontology ; rdfs:label "충파모 E06 최소 제조 데이터 어휘" ; rdfs:comment "레코드 노드(cp:*Record)와 업무 키 노드(cp:Product 등)를 구분한다" .

cp:Dataset a owl:Class ; rdfs:label "데이터셋" .
cp:hasKey a owl:ObjectProperty ; rdfs:comment "레코드 → 업무 키 노드" .
cp:inDataset a owl:ObjectProperty ; rdfs:range cp:Dataset .
cp:datasetId a owl:DatatypeProperty .
cp:datasetSha256 a owl:DatatypeProperty .
cp:groundTruthSha256 a owl:DatatypeProperty .
cp:builtBy a owl:DatatypeProperty .

cp:UnitRecord a owl:Class ; rdfs:label "Unit 원본 레코드" .
cp:Unit a owl:Class ; rdfs:label "Unit (업무 키로 식별되는 개체)" .
cp:Unit_record_uid a owl:DatatypeProperty ; rdfs:domain cp:UnitRecord ; rdfs:range xsd:string .
cp:Unit_origin_class a owl:DatatypeProperty ; rdfs:domain cp:UnitRecord ; rdfs:range xsd:string .
cp:Unit_unit_code a owl:DatatypeProperty ; rdfs:domain cp:UnitRecord ; rdfs:range xsd:string .
cp:Unit_dimension a owl:DatatypeProperty ; rdfs:domain cp:UnitRecord ; rdfs:range xsd:string .
cp:Unit_base_unit_code a owl:ObjectProperty ; rdfs:domain cp:UnitRecord ; rdfs:range cp:Unit .
cp:Unit_to_base_factor a owl:DatatypeProperty ; rdfs:domain cp:UnitRecord ; rdfs:range xsd:decimal .

cp:ProductRecord a owl:Class ; rdfs:label "Product 원본 레코드" .
cp:Product a owl:Class ; rdfs:label "Product (업무 키로 식별되는 개체)" .
cp:Product_record_uid a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:string .
cp:Product_origin_class a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:string .
cp:Product_product_id a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:string .
cp:Product_product_name a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:string .
cp:Product_product_type a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:string .
cp:Product_base_unit a owl:ObjectProperty ; rdfs:domain cp:ProductRecord ; rdfs:range cp:Unit .
cp:Product_safety_stock_qty a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:decimal .
cp:Product_manuf_lead_time_days a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:integer .
cp:Product_outsourcing_allowed a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:boolean .
cp:Product_outsourcing_unit_cost a owl:DatatypeProperty ; rdfs:domain cp:ProductRecord ; rdfs:range xsd:decimal .

