cp:BOMLine_record_uid a owl:DatatypeProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range xsd:string .
cp:BOMLine_origin_class a owl:DatatypeProperty ; rdfs:domain cp:BOMLineRecord ; rdfs:range xsd:string .
