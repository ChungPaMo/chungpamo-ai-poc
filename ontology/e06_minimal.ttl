cp:Order_record_uid a owl:DatatypeProperty ; rdfs:domain cp:OrderRecord ; rdfs:range xsd:string .
cp:Order_origin_class a owl:DatatypeProperty ; rdfs:domain cp:OrderRecord ; rdfs:range xsd:string .
