cp:Order_order_qty a owl:DatatypeProperty ; rdfs:domain cp:OrderRecord ; rdfs:range xsd:decimal .
cp:Order_unit a owl:ObjectProperty ; rdfs:domain cp:OrderRecord ; rdfs:range cp:Unit .
cp:Order_order_date a owl:DatatypeProperty ; rdfs:domain cp:OrderRecord ; rdfs:range xsd:date .
cp:Order_due_date a owl:DatatypeProperty ; rdfs:domain cp:OrderRecord ; rdfs:range xsd:date .
