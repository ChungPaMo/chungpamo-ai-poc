<http://example.org/chungpamo/e06/shape/S08/ProductionPlanLine/*/dup> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "업무 키 중복 (QR-01) — 단일 키 또는 복합 키(BOMLine bom_id+line_no, SupplierMaterial, SalesHistory, Operation, PlanLine)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:hasKey ?k . ?o cp:hasKey ?k . FILTER(?o != $this) BIND(STR(?k) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "S08" ; cp:fieldName "*" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B01/BOMLine/component_product_id/cycle> a sh:NodeShape ; sh:targetClass cp:BOMLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "다단계 BOM 순환 (자기 참조 포함, QR-05)" ;
        sh:select """SELECT $this ?value WHERE {
  $this cp:BOMLine_component_type "PRODUCT" ; cp:BOMLine_bom_id ?b ; cp:BOMLine_component_product_id ?v .
  ?bom cp:hasKey ?b ; cp:BOM_product_id ?u .
  FILTER(?u = ?v || EXISTS { ?v (^cp:BOM_product_id/cp:hasKey/^cp:BOMLine_bom_id/cp:BOMLine_component_product_id)+ ?u })
  BIND(STR(?v) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B01" ; cp:fieldName "component_product_id" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B02/BOM/*/overlap> a sh:NodeShape ; sh:targetClass cp:BOMRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "같은 제품의 활성·승인 버전 유효 조건 중복 (기간·수량·사이트 동시 겹침, QR-06 ①)" ;
        sh:select """SELECT $this ?value WHERE {
  $this cp:BOM_status "APPROVED" ; cp:BOM_is_active true ; cp:BOM_product_id ?p ; cp:BOM_valid_from ?xf ; cp:BOM_min_qty ?xn .
  ?y cp:BOM_product_id ?p ; cp:BOM_status "APPROVED" ; cp:BOM_is_active true ; cp:BOM_valid_from ?yf ; cp:BOM_min_qty ?yn .
  FILTER(?y != $this)
  OPTIONAL { $this cp:BOM_valid_to ?xt } OPTIONAL { ?y cp:BOM_valid_to ?yt } OPTIONAL { $this cp:BOM_max_qty ?xm } OPTIONAL { ?y cp:BOM_max_qty ?ym }
  OPTIONAL { $this cp:BOM_site_id ?xs } OPTIONAL { ?y cp:BOM_site_id ?ys }
  FILTER((!BOUND(?yt) || ?xf <= ?yt) && (!BOUND(?xt) || ?yf <= ?xt) && (!BOUND(?ym) || ?xn < ?ym) && (!BOUND(?xm) || ?yn < ?xm)
         && (!BOUND(?xs) || !BOUND(?ys) || ?xs = ?ys))
  BIND(STR(?y) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B02" ; cp:fieldName "*" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B03/BOM/status/active_draft> a sh:NodeShape ; sh:targetClass cp:BOMRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "미승인(DRAFT) 버전이 활성 (QR-06 ②)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:BOM_is_active true ; cp:BOM_status ?value . FILTER(STR(?value) != "APPROVED" && STR(?value) != "") }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B03" ; cp:fieldName "status" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B04/BOM/*/version_dup> a sh:NodeShape ; sh:targetClass cp:BOMRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "같은 제품·버전 표기 중복 (QR-06 ③, UK product_id+bom_version)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:BOM_product_id ?p ; cp:BOM_bom_version ?value . FILTER(STR(?value) != "")
  ?o cp:BOM_product_id ?p ; cp:BOM_bom_version ?value . FILTER(?o != $this) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B04" ; cp:fieldName "*" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B05/BOM/valid_to/order> a sh:PropertyShape ; sh:targetClass cp:BOMRecord ; sh:path cp:BOM_valid_from ;
    sh:lessThanOrEquals cp:BOM_valid_to ;
    sh:severity sh:Violation ; cp:ruleId "B05" ; cp:fieldName "valid_to" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/B05/BOM/max_qty/order> a sh:PropertyShape ; sh:targetClass cp:BOMRecord ; sh:path cp:BOM_min_qty ;
    sh:lessThan cp:BOM_max_qty ;
    sh:severity sh:Violation ; cp:ruleId "B05" ; cp:fieldName "max_qty" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/B06/ProductionPlanLine/product_id/none> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "계획 라인의 (제품, 기간 시작일, 계획 수량)에 적용 가능한 활성 BOM이 0개(선택 불가) 또는 2개 이상(모호) (QR-06 ⑤, BOM 선택 규칙)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:ProductionPlanLine_production_mode "INHOUSE" ; cp:ProductionPlanLine_period_start ?d ; cp:ProductionPlanLine_planned_qty ?q ; cp:ProductionPlanLine_product_id ?p .
  FILTER(?d >= "0001-01-01"^^xsd:date && ?q >= 0)
  FILTER NOT EXISTS { ?b cp:BOM_product_id ?p ; cp:BOM_status "APPROVED" ; cp:BOM_is_active true ;
              cp:BOM_valid_from ?vfb ; cp:BOM_min_qty ?mnb .
        OPTIONAL { ?b cp:BOM_valid_to ?vtb } OPTIONAL { ?b cp:BOM_max_qty ?mxb } OPTIONAL { ?b cp:BOM_site_id ?stb }
        FILTER(?vfb <= ?d && (!BOUND(?vtb) || ?d <= ?vtb) && ?mnb <= ?q && (!BOUND(?mxb) || ?q < ?mxb) && !BOUND(?stb)) }
  BIND(STR(?p) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B06" ; cp:fieldName "product_id" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B06/ProductionPlanLine/product_id/ambiguous> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "계획 라인의 (제품, 기간 시작일, 계획 수량)에 적용 가능한 활성 BOM이 0개(선택 불가) 또는 2개 이상(모호) (QR-06 ⑤, BOM 선택 규칙)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:ProductionPlanLine_production_mode "INHOUSE" ; cp:ProductionPlanLine_period_start ?d ; cp:ProductionPlanLine_planned_qty ?q ; cp:ProductionPlanLine_product_id ?p .
  FILTER(?d >= "0001-01-01"^^xsd:date && ?q >= 0)
  ?b cp:BOM_product_id ?p ; cp:BOM_status "APPROVED" ; cp:BOM_is_active true ;
              cp:BOM_valid_from ?vfb ; cp:BOM_min_qty ?mnb .
        OPTIONAL { ?b cp:BOM_valid_to ?vtb } OPTIONAL { ?b cp:BOM_max_qty ?mxb } OPTIONAL { ?b cp:BOM_site_id ?stb }
        FILTER(?vfb <= ?d && (!BOUND(?vtb) || ?d <= ?vtb) && ?mnb <= ?q && (!BOUND(?mxb) || ?q < ?mxb) && !BOUND(?stb))
  ?c cp:BOM_product_id ?p ; cp:BOM_status "APPROVED" ; cp:BOM_is_active true ;
              cp:BOM_valid_from ?vfc ; cp:BOM_min_qty ?mnc .
        OPTIONAL { ?c cp:BOM_valid_to ?vtc } OPTIONAL { ?c cp:BOM_max_qty ?mxc } OPTIONAL { ?c cp:BOM_site_id ?stc }
        FILTER(?vfc <= ?d && (!BOUND(?vtc) || ?d <= ?vtc) && ?mnc <= ?q && (!BOUND(?mxc) || ?q < ?mxc) && !BOUND(?stc))
  FILTER(?b != ?c) BIND(STR(?p) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B06" ; cp:fieldName "product_id" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B07/BOMLine/component_type/consistency> a sh:NodeShape ; sh:targetClass cp:BOMLineRecord ;
    sh:or ( [ sh:not [ sh:path cp:BOMLine_component_type ; sh:in ( "MATERIAL" "PRODUCT" ) ; sh:minCount 1 ] ]
      [ sh:and ( [ sh:path cp:BOMLine_component_type ; sh:hasValue "MATERIAL" ] [ sh:path cp:BOMLine_component_material_id ; sh:minCount 1 ] [ sh:path cp:BOMLine_component_product_id ; sh:maxCount 0 ] ) ]
      [ sh:and ( [ sh:path cp:BOMLine_component_type ; sh:hasValue "PRODUCT" ] [ sh:path cp:BOMLine_component_product_id ; sh:minCount 1 ] [ sh:path cp:BOMLine_component_material_id ; sh:maxCount 0 ] ) ] ) ;
    sh:severity sh:Violation ; cp:ruleId "B07" ; cp:fieldName "component_type" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/B08/BOMLine/unit/dimension> a sh:NodeShape ; sh:targetClass cp:BOMLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "수량 단위의 차원이 품목 기준 단위 차원과 다름 (예: kg 자재에 EA, QR-03 ②). 같은 차원 다른 단위(g↔kg)는 정상" ;
        sh:select """SELECT $this ?value WHERE {
  { $this cp:BOMLine_component_type "MATERIAL" ; cp:BOMLine_component_material_id ?i . ?ir cp:hasKey ?i ; cp:Material_base_unit ?bu }
  UNION { $this cp:BOMLine_component_type ?t . FILTER(STR(?t) != "MATERIAL") $this cp:BOMLine_component_product_id ?i . ?ir cp:hasKey ?i ; cp:Product_base_unit ?bu }
  $this cp:BOMLine_unit ?u . ?ur cp:hasKey ?u ; cp:Unit_dimension ?du .
  ?br cp:hasKey ?bu ; cp:Unit_dimension ?db . FILTER(STR(?du) != STR(?db)) BIND(STR(?u) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B08" ; cp:fieldName "unit" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B08/Order/unit/dimension> a sh:NodeShape ; sh:targetClass cp:OrderRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "수량 단위의 차원이 품목 기준 단위 차원과 다름 (예: kg 자재에 EA, QR-03 ②). 같은 차원 다른 단위(g↔kg)는 정상" ;
        sh:select """SELECT $this ?value WHERE { $this cp:Order_product_id ?i . ?ir cp:hasKey ?i ; cp:Product_base_unit ?bu .
  $this cp:Order_unit ?u . ?ur cp:hasKey ?u ; cp:Unit_dimension ?du .
  ?br cp:hasKey ?bu ; cp:Unit_dimension ?db . FILTER(STR(?du) != STR(?db)) BIND(STR(?u) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B08" ; cp:fieldName "unit" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B08/Inventory/unit/dimension> a sh:NodeShape ; sh:targetClass cp:InventoryRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "수량 단위의 차원이 품목 기준 단위 차원과 다름 (예: kg 자재에 EA, QR-03 ②). 같은 차원 다른 단위(g↔kg)는 정상" ;
        sh:select """SELECT $this ?value WHERE { $this cp:Inventory_item_id ?i . ?ir cp:hasKey ?i ; (cp:Material_base_unit|cp:Product_base_unit) ?bu .
  $this cp:Inventory_unit ?u . ?ur cp:hasKey ?u ; cp:Unit_dimension ?du .
  ?br cp:hasKey ?bu ; cp:Unit_dimension ?db . FILTER(STR(?du) != STR(?db)) BIND(STR(?u) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B08" ; cp:fieldName "unit" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B08/ProductionPlanLine/unit/dimension> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "수량 단위의 차원이 품목 기준 단위 차원과 다름 (예: kg 자재에 EA, QR-03 ②). 같은 차원 다른 단위(g↔kg)는 정상" ;
        sh:select """SELECT $this ?value WHERE { $this cp:ProductionPlanLine_product_id ?i . ?ir cp:hasKey ?i ; cp:Product_base_unit ?bu .
  $this cp:ProductionPlanLine_unit ?u . ?ur cp:hasKey ?u ; cp:Unit_dimension ?du .
  ?br cp:hasKey ?bu ; cp:Unit_dimension ?db . FILTER(STR(?du) != STR(?db)) BIND(STR(?u) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B08" ; cp:fieldName "unit" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B09/BOM/*/has_line> a sh:PropertyShape ; sh:targetClass cp:BOMRecord ; sh:path ( cp:hasKey [ sh:inversePath cp:BOMLine_bom_id ] ) ;
    sh:minCount 1 ;
    sh:severity sh:Warning ; cp:ruleId "B09" ; cp:fieldName "*" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/B10/BOMLine/*/same_component> a sh:NodeShape ; sh:targetClass cp:BOMLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "같은 BOM 안에 같은 구성품이 두 번 이상" ;
        sh:select """SELECT $this ?value WHERE { $this cp:BOMLine_bom_id ?b . { $this cp:BOMLine_component_material_id ?c } UNION { $this cp:BOMLine_component_product_id ?c }
  ?o cp:BOMLine_bom_id ?b . { ?o cp:BOMLine_component_material_id ?c } UNION { ?o cp:BOMLine_component_product_id ?c }
  FILTER(?o != $this) BIND(STR(?c) AS ?value) }""" ] ;
    sh:severity sh:Warning ; cp:ruleId "B10" ; cp:fieldName "*" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B11/SupplierMaterial/is_preferred/none> a sh:NodeShape ; sh:targetClass cp:SupplierMaterialRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "자재당 우선 공급사(is_preferred=TRUE)가 정확히 1개가 아님 (공급 관계가 있는 자재 기준)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:SupplierMaterial_material_id ?m .
  FILTER NOT EXISTS { ?s cp:SupplierMaterial_material_id ?m ; cp:SupplierMaterial_is_preferred true } BIND(STR(?m) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B11" ; cp:fieldName "is_preferred" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B11/SupplierMaterial/is_preferred/multiple> a sh:NodeShape ; sh:targetClass cp:SupplierMaterialRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "자재당 우선 공급사(is_preferred=TRUE)가 정확히 1개가 아님 (공급 관계가 있는 자재 기준)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:SupplierMaterial_material_id ?m . ?a cp:SupplierMaterial_material_id ?m ; cp:SupplierMaterial_is_preferred true . BIND(STR(?m) AS ?value) }
GROUP BY $this ?value HAVING (COUNT(DISTINCT ?a) > 1)""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B11" ; cp:fieldName "is_preferred" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B12/SalesHistory/allocation_share/sum> a sh:NodeShape ; sh:targetClass cp:SalesHistoryRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "같은 원본 레코드에서 배분한 행들의 allocation_share 합 ≠ 1 (허용오차 0.0005)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:SalesHistory_generation_method "ALLOCATED" ; cp:SalesHistory_derived_from_record_uid ?src ; cp:SalesHistory_allocation_share ?value .
  ?r cp:SalesHistory_derived_from_record_uid ?src ; cp:SalesHistory_allocation_share ?s ; cp:SalesHistory_generation_method "ALLOCATED" }
GROUP BY $this ?value HAVING (ABS(SUM(?s) - 1) > 0.0005)""" ] ;
    sh:severity sh:Violation ; cp:ruleId "B12" ; cp:fieldName "allocation_share" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/B13/SalesHistory/derived_from_record_uid/allocated_requires> a sh:NodeShape ; sh:targetClass cp:SalesHistoryRecord ;
    sh:or ( [ sh:not [ sh:path cp:SalesHistory_generation_method ; sh:hasValue "ALLOCATED" ] ] [ sh:path cp:SalesHistory_derived_from_record_uid ; sh:minCount 1 ] ) ;
    sh:severity sh:Violation ; cp:ruleId "B13" ; cp:fieldName "derived_from_record_uid" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/B13/SalesHistory/allocation_share/allocated_requires> a sh:NodeShape ; sh:targetClass cp:SalesHistoryRecord ;
    sh:or ( [ sh:not [ sh:path cp:SalesHistory_generation_method ; sh:hasValue "ALLOCATED" ] ] [ sh:path cp:SalesHistory_allocation_share ; sh:minCount 1 ] ) ;
    sh:severity sh:Violation ; cp:ruleId "B13" ; cp:fieldName "allocation_share" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/B14/Product/outsourcing_unit_cost/cost_only_if_allowed> a sh:NodeShape ; sh:targetClass cp:ProductRecord ;
    sh:or ( [ sh:not [ sh:path cp:Product_outsourcing_allowed ; sh:datatype xsd:boolean ; sh:minCount 1 ] ]
      [ sh:and ( [ sh:path cp:Product_outsourcing_allowed ; sh:hasValue true ] [ sh:path cp:Product_outsourcing_unit_cost ; sh:minCount 1 ] ) ]
      [ sh:and ( [ sh:path cp:Product_outsourcing_allowed ; sh:hasValue false ] [ sh:path cp:Product_outsourcing_unit_cost ; sh:maxCount 0 ] ) ] ) ;
    sh:severity sh:Violation ; cp:ruleId "B14" ; cp:fieldName "outsourcing_unit_cost" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/V02/Inventory/allocated_qty/le_on_hand> a sh:PropertyShape ; sh:targetClass cp:InventoryRecord ; sh:path cp:Inventory_allocated_qty ;
    sh:lessThanOrEquals cp:Inventory_on_hand_qty ;
    sh:severity sh:Violation ; cp:ruleId "V02" ; cp:fieldName "allocated_qty" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/V03/Inventory/on_hand_qty/ea_integer> a sh:NodeShape ; sh:targetClass cp:InventoryRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "단위가 EA인데 소수 수량 (QR-07 ③)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:Inventory_unit <http://example.org/chungpamo/e06/id/Unit/EA> ; cp:Inventory_on_hand_qty ?value . FILTER(?value != FLOOR(?value)) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "V03" ; cp:fieldName "on_hand_qty" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/V03/Inventory/allocated_qty/ea_integer> a sh:NodeShape ; sh:targetClass cp:InventoryRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "단위가 EA인데 소수 수량 (QR-07 ③)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:Inventory_unit <http://example.org/chungpamo/e06/id/Unit/EA> ; cp:Inventory_allocated_qty ?value . FILTER(?value != FLOOR(?value)) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "V03" ; cp:fieldName "allocated_qty" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/V03/Inventory/on_order_qty/ea_integer> a sh:NodeShape ; sh:targetClass cp:InventoryRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "단위가 EA인데 소수 수량 (QR-07 ③)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:Inventory_unit <http://example.org/chungpamo/e06/id/Unit/EA> ; cp:Inventory_on_order_qty ?value . FILTER(?value != FLOOR(?value)) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "V03" ; cp:fieldName "on_order_qty" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/V05/Inventory/expected_receipt_date/receipt_required> a sh:NodeShape ; sh:targetClass cp:InventoryRecord ;
    sh:or ( [ sh:path cp:Inventory_on_order_qty ; sh:maxInclusive 0 ] [ sh:path cp:Inventory_expected_receipt_date ; sh:minCount 1 ] ) ;
    sh:severity sh:Violation ; cp:ruleId "V05" ; cp:fieldName "expected_receipt_date" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/V06/Inventory/as_of_date/le_reference> a sh:PropertyShape ; sh:targetClass cp:InventoryRecord ; sh:path cp:Inventory_as_of_date ;
    sh:maxInclusive "2026-11-15"^^xsd:date ;
    sh:severity sh:Violation ; cp:ruleId "V06" ; cp:fieldName "as_of_date" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/V07/Order/due_date/ge_order> a sh:PropertyShape ; sh:targetClass cp:OrderRecord ; sh:path cp:Order_order_date ;
    sh:lessThanOrEquals cp:Order_due_date ;
    sh:severity sh:Violation ; cp:ruleId "V07" ; cp:fieldName "due_date" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/V08/Order/product_id/no_operation> a sh:NodeShape ; sh:targetClass cp:OrderRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "주문·자체 생산 계획 대상 제품에 공정(Operation)이 없음 (QR-08 ②)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:Order_status "OPEN" ; cp:Order_product_id ?p . FILTER NOT EXISTS { ?op cp:Operation_product_id ?p } BIND(STR(?p) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "V08" ; cp:fieldName "product_id" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/V08/ProductionPlanLine/product_id/no_operation> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "주문·자체 생산 계획 대상 제품에 공정(Operation)이 없음 (QR-08 ②)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:ProductionPlanLine_production_mode "INHOUSE" ; cp:ProductionPlanLine_product_id ?p . FILTER NOT EXISTS { ?op cp:Operation_product_id ?p } BIND(STR(?p) AS ?value) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "V08" ; cp:fieldName "product_id" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/V09/ProductionPlanLine/resource_id/resource_in_routing> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "계획 라인의 자원이 그 제품 공정에 없는 자원 (QR-08 ③)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:ProductionPlanLine_production_mode "INHOUSE" ; cp:ProductionPlanLine_product_id ?p ; cp:ProductionPlanLine_resource_id ?value .
  FILTER EXISTS { ?op cp:Operation_product_id ?p }
  FILTER NOT EXISTS { ?op2 cp:Operation_product_id ?p ; cp:Operation_resource_id ?value } }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "V09" ; cp:fieldName "resource_id" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/V10/ProductionPlanLine/resource_id/mode_resource> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "외주 라인에 자원이 있거나 자체 생산 라인에 자원이 없음 (QR-08 ④의 v2 형태)" ;
        sh:select """SELECT $this ?value WHERE { $this cp:ProductionPlanLine_production_mode ?value . FILTER(STR(?value) = "INHOUSE" || STR(?value) = "OUTSOURCE")
  BIND(EXISTS { $this cp:ProductionPlanLine_resource_id ?r } AS ?hasR) FILTER((STR(?value) = "OUTSOURCE") = ?hasR) }""" ] ;
    sh:severity sh:Violation ; cp:ruleId "V10" ; cp:fieldName "resource_id" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/V11/ProductionPlanLine/production_mode/outsource_not_allowed> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "외주 불가 제품(outsourcing_allowed=false)의 외주 라인" ;
        sh:select """SELECT $this ?value WHERE { $this cp:ProductionPlanLine_production_mode ?value ; cp:ProductionPlanLine_product_id ?p . FILTER(STR(?value) = "OUTSOURCE")
  ?pr cp:hasKey ?p ; cp:Product_outsourcing_allowed false }""" ] ;
    sh:severity sh:Warning ; cp:ruleId "V11" ; cp:fieldName "production_mode" ; cp:engine "SPARQL" .

<http://example.org/chungpamo/e06/shape/V12/ProductionPlanLine/period_start/within_horizon> a sh:NodeShape ; sh:targetClass cp:ProductionPlanLineRecord ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/chungpamo/e06/shape/prefixes> ; sh:message "계획 라인 기간 시작일이 계획 기간(horizon) 밖" ;
        sh:select """SELECT $this ?value WHERE { $this cp:ProductionPlanLine_period_start ?value ; cp:ProductionPlanLine_plan_id ?pl .
  ?pr cp:hasKey ?pl ; cp:ProductionPlan_horizon_start ?hs ; cp:ProductionPlan_horizon_end ?he .
  FILTER(?value < ?hs || ?value > ?he) }""" ] ;
    sh:severity sh:Warning ; cp:ruleId "V12" ; cp:fieldName "period_start" ; cp:engine "SPARQL" .
