# E06 SHACL shapes (scripts/e06_shapes.py가 생성 — 직접 수정하지 말고 생성기를 고친다).
# 비교 제약 방식: core. 규칙 ID는 configs/e05_validation_rules.json. V13(생산능력)은 shape 없음.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix cp: <http://example.org/chungpamo/e06/ns#> .

<http://example.org/chungpamo/e06/shape/prefixes> sh:declare [ sh:prefix "cp" ; sh:namespace "http://example.org/chungpamo/e06/ns#"^^xsd:anyURI ] ,
    [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
    [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .

<http://example.org/chungpamo/e06/shape/S01/Unit/record_uid/minCount> a sh:PropertyShape ; sh:targetClass cp:UnitRecord ; sh:path cp:Unit_record_uid ;
    sh:minCount 1 ;
    sh:severity sh:Violation ; cp:ruleId "S01" ; cp:fieldName "record_uid" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/S01/Unit/record_uid/blank> a sh:PropertyShape ; sh:targetClass cp:UnitRecord ; sh:path cp:Unit_record_uid ;
    sh:minLength 1 ;
    sh:severity sh:Violation ; cp:ruleId "S01" ; cp:fieldName "record_uid" ; cp:engine "CORE" .

<http://example.org/chungpamo/e06/shape/S01/Unit/origin_class/minCount> a sh:PropertyShape ; sh:targetClass cp:UnitRecord ; sh:path cp:Unit_origin_class ;
    sh:minCount 1 ;
